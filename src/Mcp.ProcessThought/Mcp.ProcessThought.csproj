<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!-- NuGet Tool Packaging -->
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>mcp-process-thought</ToolCommandName>
    <IsPackable>true</IsPackable>
    <PackageType>DotnetTool;McpServer</PackageType>

    <!-- Package Metadata -->
    <PackageId>Mcp.ProcessThought</PackageId>
    <Version>1.0.2</Version>
    <Authors>d-german</Authors>
    <Description>Standalone MCP server exposing a concise process_thought tool for structured, evidence-based reasoning.</Description>
    <PackageProjectUrl>https://github.com/d-german/mcp-task-and-research</PackageProjectUrl>
    <RepositoryUrl>https://github.com/d-german/mcp-task-and-research</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>mcp;model-context-protocol;reasoning;process-thought;ai-assistant</PackageTags>
    <PackageReleaseNotes>1.0.2 adds the official McpServer package type and discovery manifest. It also includes the concise responses, template compatibility, validation, corrected setup documentation, and stable MCP SDK upgrade introduced in 1.0.1.</PackageReleaseNotes>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
    <None Include=".mcp\server.json" Pack="true" PackagePath=".mcp\server.json" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.10" />
    <PackageReference Include="ModelContextProtocol" Version="1.4.1" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Prompts\**\*.md" Pack="false">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
